# Secrets for the argus-scout quickstart. Copy to .env in this directory (it is gitignored) and fill in.
# scout.yaml names these variables; the values live only here or in the container's environment.

# Bearer token for write routes (server.token_env). Writes stay refused while server.read_only is true:
# set this, set read_only: false in scout.yaml, then `docker compose restart scout`.
# Generate one with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SCOUT_API_TOKEN=

# A webhook source with its own token (sources[].token_env), if you add one.
# SCOUT_CI_TOKEN=
