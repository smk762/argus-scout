# Secrets for argus-scout. Copy to .env beside scout.yaml and fill in.
# scout.yaml names these variables; the values live only here or in the real
# environment, which wins over this file. Never commit .env.

# Bearer token for write routes (server.token_env).
SCOUT_API_TOKEN=

# Per-source tokens, if a source names one (sources[].token_env / auth_env).
# SCOUT_CI_TOKEN=
# SCOUT_BACKUPS_AUTH=Bearer <TOKEN>

# Hosted LLM backends only (services.llm.api_key_env).
# SCOUT_LLM_API_KEY=

# Webhook channels, if one names them (channels[].token_env / secret_env).
# SCOUT_CHAT_TOKEN=
# SCOUT_CHAT_SECRET=

# GPU leases (services.llm.gpu), host-wide: every argus service on the host
# uses the same values, so they usually live in the host's environment.
# ARGUS_GPU_COORDINATOR=broker            # none (default), lease or broker
# ARGUS_GPU_BROKER_URL=http://<GPU_BROKER_HOST>:8120
# ARGUS_GPU_BROKER_TOKEN=
# ARGUS_GPU_TENANT_MANIFEST=/app/gpu-tenant.yaml
# ARGUS_GPU_LEASE_TIMEOUT_S=300            # past this the report uses its template
