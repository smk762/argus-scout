# Secrets for argus-scout. Copy to .env beside scout.yaml and fill in.
# scout.yaml names these variables; the values live only here or in the real
# environment, which wins over this file. Never commit .env.

# Bearer token for write routes (server.token_env).
SCOUT_API_TOKEN=

# Per-source tokens, if a source names one (sources[].token_env / auth_env).
# SCOUT_CI_TOKEN=
# SCOUT_BACKUPS_AUTH=Bearer <TOKEN>

# Hosted LLM backends only (services.llm.api_key_env).
# SCOUT_LLM_API_KEY=

# Webhook channels, if one names them (channels[].token_env / secret_env).
# SCOUT_CHAT_TOKEN=
# SCOUT_CHAT_SECRET=

# GPU leases (services.llm.gpu), host-wide: every argus service on the host uses
# the same values, so they belong in the suite settings file, ~/.config/argus/suite.env
# (mode 600; `python -m argus_cortex.settings --init` creates it), or the host's
# environment. Set here, they win over the suite file.
# The broker URL and token are all argus-iris needs:
# ARGUS_GPU_BROKER_URL=http://<GPU_BROKER_HOST>:8120
# ARGUS_GPU_BROKER_TOKEN=
# With no broker, a host lock shares the GPU instead. Comment it out when the two
# broker variables are set.
# ARGUS_GPU_COORDINATOR=lease
# ARGUS_GPU_LEASE_TIMEOUT_S=300            # past this the report uses its template

# Suite-wide service URLs, read when scout.yaml leaves a url out (services.echo
# with `peer:`, a mask channel). Also better kept in the suite file.
# ARGUS_XTTS_URL=http://<ECHO_HOST>:8141
# ARGUS_TTS_URL=http://<ECHO_HOST>:8142
# ARGUS_MASK_URL=http://<MASK_HOST>:8109
